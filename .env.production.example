# HTTPS 公開用の見本。実際の値は .env / 公開先の環境設定へ入れてください。
# このファイルの example.com は、ご自身のドメインと連絡先へ変更します。
DOMAIN=flights.example.com
ACME_EMAIL=owner@example.com
PUBLIC_ORIGIN=https://flights.example.com
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/flights.sqlite
BACKGROUND_REFRESH=true
# Caddy と Compose を使う場合は app の設定で 1 に上書きします。
TRUST_PROXY_HOPS=0
API_RATE_LIMIT_PER_MINUTE=180
# OpenSky クライアントがない場合も匿名で取得できます。
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# 未設定時: 匿名900秒、OAuth120秒。契約の取得枠を確認してから変更します。
# POLL_INTERVAL_SECONDS=900
