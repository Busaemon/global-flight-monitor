# このファイルを .env にコピーしてください。秘密の値は Git にコミットしません。
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/flights.sqlite
# OpenSky OAuth クライアントの設定は任意です。匿名アクセスでも動作します。
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# 省略時は匿名 900 秒、OAuth 120 秒。短縮すると API の1日当たり上限に達します。
# POLL_INTERVAL_SECONDS=900
# 開発では background refresh は既定で無効、本番 NODE_ENV=production では有効。
# BACKGROUND_REFRESH=false
# 公開時は HTTPS の正確な origin を設定します。例は見本です。
# PUBLIC_ORIGIN=https://flights.example.com
# 直接接続は 0。専用のリバースプロキシ経由だけの場合に限り変更します。
TRUST_PROXY_HOPS=0
API_RATE_LIMIT_PER_MINUTE=180
